<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VmManager.Agent</RootNamespace>
    <AssemblyName>VmManager.Agent</AssemblyName>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <OutDir>..\..\..\dist\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VmManager.Contracts\VmManager.Contracts.csproj" />
    <ProjectReference Include="..\VmManager.Backends\VmManager.Backends.csproj" />
    <ProjectReference Include="..\VmManager.Catalog\VmManager.Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.*" />
    <PackageReference Include="MudBlazor" Version="9.5.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.*" />
    <PackageReference Include="System.Management" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VmManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Components\" />
    <Folder Include="Layout\" />
  </ItemGroup>
</Project>
